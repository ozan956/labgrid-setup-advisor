{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://labgrid.org/schemas/setup-advisor/bench-profile-v1.json",
  "title": "Labgrid Setup Advisor bench profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "board", "topology", "sharing", "names", "devices"],
  "properties": {
    "version": { "const": 1 },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "presetId": { "$ref": "#/definitions/kebab" }
      }
    },
    "topology": { "enum": ["local", "remote"] },
    "sharing": { "enum": ["solo", "team"] },
    "names": {
      "type": "object",
      "additionalProperties": false,
      "required": ["place", "group", "exporterHost", "coordinator", "location"],
      "properties": {
        "place": { "type": "string", "maxLength": 200 },
        "group": { "type": "string", "maxLength": 200 },
        "exporterHost": { "type": "string", "maxLength": 253 },
        "coordinator": { "type": "string", "maxLength": 260 },
        "location": { "type": "string", "maxLength": 200 }
      }
    },
    "devices": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/definitions/device" }
    },
    "login": {
      "type": "object",
      "additionalProperties": false,
      "required": ["username", "prompt", "loginPrompt"],
      "properties": {
        "username": { "type": "string", "maxLength": 200 },
        "prompt": { "type": "string", "maxLength": 500 },
        "loginPrompt": { "type": "string", "maxLength": 500 }
      }
    },
    "bootloader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "prompt"],
      "properties": {
        "kind": { "enum": ["uboot", "barebox"] },
        "prompt": { "type": "string", "maxLength": 500 }
      }
    }
  },
  "definitions": {
    "kebab": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "deviceId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 100 },
    "text": { "type": "string", "maxLength": 500 },
    "hex4": { "type": "string", "pattern": "^[0-9a-fA-F]{4}$" },
    "usbId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendorId", "productId"],
      "properties": {
        "vendorId": { "$ref": "#/definitions/hex4" },
        "productId": { "$ref": "#/definitions/hex4" }
      }
    },
    "match": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": { "pattern": "^@?[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": { "type": "string", "maxLength": 500 }
    },
    "speed": { "type": "integer", "minimum": 1, "maximum": 100000000 },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "base": {
      "type": "object",
      "required": ["id", "label", "kind"],
      "properties": {
        "id": { "$ref": "#/definitions/deviceId" },
        "label": { "$ref": "#/definitions/text" },
        "note": { "type": "string", "maxLength": 1000 }
      }
    },
    "device": {
      "type": "object",
      "required": ["id", "label", "kind"],
      "discriminator": { "propertyName": "kind" },
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "kind", "match", "speed"],
          "properties": {
            "id": { "$ref": "#/definitions/deviceId" },
            "label": { "$ref": "#/definitions/text" },
            "note": { "type": "string", "maxLength": 1000 },
            "kind": { "const": "usb-serial" },
            "usbId": { "$ref": "#/definitions/usbId" },
            "match": { "$ref": "#/definitions/match" },
            "speed": { "$ref": "#/definitions/speed" },
            "deviceNode": { "type": "string", "maxLength": 200 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "kind", "host", "port", "speed", "protocol"],
          "properties": {
            "id": { "$ref": "#/definitions/deviceId" },
            "label": { "$ref": "#/definitions/text" },
            "note": { "type": "string", "maxLength": 1000 },
            "kind": { "const": "network-serial" },
            "host": { "type": "string", "maxLength": 253 },
            "port": { "$ref": "#/definitions/port" },
            "speed": { "$ref": "#/definitions/speed" },
            "protocol": { "enum": ["raw", "rfc2217"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "kind", "model", "host", "index"],
          "properties": {
            "id": { "$ref": "#/definitions/deviceId" },
            "label": { "$ref": "#/definitions/text" },
            "note": { "type": "string", "maxLength": 1000 },
            "kind": { "const": "network-pdu" },
            "model": { "type": "string", "maxLength": 100 },
            "host": { "type": "string", "maxLength": 500 },
            "index": { "type": "integer", "minimum": 0, "maximum": 1000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "kind", "serial", "index"],
          "properties": {
            "id": { "$ref": "#/definitions/deviceId" },
            "label": { "$ref": "#/definitions/text" },
            "note": { "type": "string", "maxLength": 1000 },
            "kind": { "const": "ykush" },
            "serial": { "type": "string", "maxLength": 100 },
            "index": { "type": "string", "pattern": "^(a|[0-9]{1,3})$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "kind", "match", "index"],
          "properties": {
            "id": { "$ref": "#/definitions/deviceId" },
            "label": { "$ref": "#/definitions/text" },
            "note": { "type": "string", "maxLength": 1000 },
            "kind": { "const": "usb-hub-port" },
            "match": { "$ref": "#/definitions/match" },
            "index": { "type": "integer", "minimum": 1, "maximum": 127 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "kind"],
          "properties": {
            "id": { "$ref": "#/definitions/deviceId" },
            "label": { "$ref": "#/definitions/text" },
            "note": { "type": "string", "maxLength": 1000 },
            "kind": { "const": "manual-power" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "kind", "match"],
          "properties": {
            "id": { "$ref": "#/definitions/deviceId" },
            "label": { "$ref": "#/definitions/text" },
            "note": { "type": "string", "maxLength": 1000 },
            "kind": { "const": "usb-debugger" },
            "usbId": { "$ref": "#/definitions/usbId" },
            "match": { "$ref": "#/definitions/match" },
            "interfaceConfig": { "type": "string", "maxLength": 300 },
            "boardConfig": { "type": "string", "maxLength": 300 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "kind", "match"],
          "properties": {
            "id": { "$ref": "#/definitions/deviceId" },
            "label": { "$ref": "#/definitions/text" },
            "note": { "type": "string", "maxLength": 1000 },
            "kind": { "const": "dfu" },
            "usbId": { "$ref": "#/definitions/usbId" },
            "match": { "$ref": "#/definitions/match" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "kind", "match", "usbId"],
          "properties": {
            "id": { "$ref": "#/definitions/deviceId" },
            "label": { "$ref": "#/definitions/text" },
            "note": { "type": "string", "maxLength": 1000 },
            "kind": { "const": "fastboot" },
            "match": { "$ref": "#/definitions/match" },
            "usbId": { "$ref": "#/definitions/usbId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "kind", "match"],
          "properties": {
            "id": { "$ref": "#/definitions/deviceId" },
            "label": { "$ref": "#/definitions/text" },
            "note": { "type": "string", "maxLength": 1000 },
            "kind": { "const": "usb-sd-mux" },
            "match": { "$ref": "#/definitions/match" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "kind", "match"],
          "properties": {
            "id": { "$ref": "#/definitions/deviceId" },
            "label": { "$ref": "#/definitions/text" },
            "note": { "type": "string", "maxLength": 1000 },
            "kind": { "const": "usb-storage" },
            "match": { "$ref": "#/definitions/match" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "kind", "match"],
          "properties": {
            "id": { "$ref": "#/definitions/deviceId" },
            "label": { "$ref": "#/definitions/text" },
            "note": { "type": "string", "maxLength": 1000 },
            "kind": { "const": "imx-usb-loader" },
            "usbId": { "$ref": "#/definitions/usbId" },
            "match": { "$ref": "#/definitions/match" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "kind", "address", "username", "port"],
          "properties": {
            "id": { "$ref": "#/definitions/deviceId" },
            "label": { "$ref": "#/definitions/text" },
            "note": { "type": "string", "maxLength": 1000 },
            "kind": { "const": "network-service" },
            "address": { "type": "string", "maxLength": 253 },
            "username": { "type": "string", "maxLength": 100 },
            "port": { "$ref": "#/definitions/port" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "kind", "usbId"],
          "properties": {
            "id": { "$ref": "#/definitions/deviceId" },
            "label": { "$ref": "#/definitions/text" },
            "note": { "type": "string", "maxLength": 1000 },
            "kind": { "const": "unsupported-usb" },
            "usbId": { "$ref": "#/definitions/usbId" }
          }
        }
      ]
    }
  }
}
