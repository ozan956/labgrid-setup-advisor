{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://labgrid.org/schemas/setup-advisor/hardware-pdu-models-v1.json",
  "title": "Labgrid Setup Advisor network power backend catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "models"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/model" }
    }
  },
  "definitions": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "family", "indexBase", "hostFormat", "confidence"],
      "properties": {
        "model": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "family": { "$ref": "#/definitions/nonEmpty" },
        "indexBase": { "enum": [0, 1] },
        "indexMax": { "type": "integer", "minimum": 1 },
        "hostFormat": { "enum": ["host", "url"] },
        "requirements": {
          "type": "array",
          "items": { "$ref": "#/definitions/nonEmpty" }
        },
        "notes": {
          "type": "array",
          "items": { "$ref": "#/definitions/nonEmpty" }
        },
        "confidence": { "enum": ["verified", "source"] }
      }
    }
  }
}
